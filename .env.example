# Required: Your Discord Bot Token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Recommended: Comma-separated Discord User IDs allowed to control Antigravity
# (Right-click your profile in Discord with Developer Mode enabled -> Copy User ID)
ALLOWED_USER_IDS=

# Backend Mode: "desktop" (bridges to your running Antigravity desktop app via agentapi)
# or "sdk" (spawns a standalone agent via the google-antigravity Python SDK)
AGY_MODE=desktop

# Model tier for chatting in DMs and top-level server channels (default, pro, flash, flash_lite)
AGY_CHAT_MODEL=flash

# Model tier for working inside Discord threads / !new (default, pro, flash, flash_lite)
AGY_THREAD_MODEL=pro
